# ==============================================================================
# Saree Wholesale Application - Environment Variables
# ==============================================================================

# MongoDB Configuration
MONGO_INITDB_DATABASE=saree_wholesale
MONGODB_URI=mongodb://mongodb:27017/saree_wholesale
# Host port mapping for MongoDB (27018 by default to avoid conflict with local mongod)
MONGO_PORT=27018

# Backend Configuration
BACKEND_PORT=8080
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=admin123
# Optional pre-hashed BCrypt password (e.g. $2a$10$...)
ADMIN_PASSWORD_HASH=

# JWT Authentication
# At least 256-bit string for HMAC-SHA256
JWT_SECRET=saree-wholesale-secure-jwt-signing-secret-key-2026-min256bit!
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# File Upload & Image URLs
UPLOAD_DIR=/app/uploads
APP_PUBLIC_URL=http://localhost:8080

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
